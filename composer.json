{
  "name": "inkwell/publication",
  "description": "Inkwell \u2014 a Medium-style publishing platform for articles, blogs and research papers, built on Kirby CMS.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "getkirby/cms": "^5.6"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true
  },
  "scripts": {
    "start": "php -S localhost:8000 vendor/getkirby/cms/router.php",
    "vercel": [
      "@php -v"
    ]
  },
  "extra": {
    "kirby-cms-path": false
  }
}
