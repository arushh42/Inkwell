{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "inkwell-arush-2b94.vercel.app" }],
      "status": 308,
      "headers": { "Location": "https://inkwellpress.vercel.app/$1" }
    },
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=86400" },
      "continue": true
    },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
