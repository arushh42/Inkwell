# Set these in Vercel → Project → Settings → Environment Variables.

# Canonical site URL (optional; defaults to the request host)
SITE_URL=https://your-project.vercel.app

# Admin account provisioned on every cold start.
# Generate the hash locally with:
#   php -r 'echo password_hash("your-password", PASSWORD_DEFAULT), PHP_EOL;'
KIRBY_ADMIN_EMAIL=you@example.com
KIRBY_ADMIN_NAME=Your Name
KIRBY_ADMIN_PASSWORD_HASH=
# Alternative: a plain password (mark it Secret in Vercel); it's hashed on startup.
# KIRBY_ADMIN_PASSWORD=

# GitHub sync: persists Panel edits by committing content/ to the repo.
# Fine-grained token, this repository only, "Contents: Read and write".
GITHUB_SYNC_TOKEN=
# Auto-detected on Vercel (VERCEL_GIT_REPO_OWNER/SLUG, VERCEL_GIT_COMMIT_REF):
# GITHUB_SYNC_REPO=owner/repo
# GITHUB_SYNC_BRANCH=main

# Upstash Redis (Vercel Marketplace, free tier) so Panel logins work across instances.
# The integration sets these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Show detailed errors (never enable in production)
KIRBY_DEBUG=false
